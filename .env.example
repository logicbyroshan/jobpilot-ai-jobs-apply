# ==========================================
# JobPilot Environment Configuration (.env)
# ==========================================

# Application
APP_NAME=JobPilot
APP_ENV=development
DEBUG=true
PORT=8000
SECRET_KEY=jobpilot-dev-insecure-secret-key-change-in-production-32bytes
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL + pgvector or SQLite for standalone dev)
# Default for Docker: postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
# Default for Standalone: sqlite+aiosqlite:///./jobpilot.db
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@localhost:5432/jobpilot
DATABASE_ECHO=false

# Cache & Background Workers (Redis)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (Local filesystem or S3-compatible)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_S3_BUCKET=jobpilot-artifacts
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin

# AI Gateway
AI_PROVIDER=mock
# Options: mock, openai, anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_COMPLETION_MODEL=gpt-4o-mini

# Source Integrations & OAuth (API keys & Client Secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
